# Clave de la API de Anthropic para el asistente con IA (https://platform.claude.com).
# Sin esta clave el chat sigue funcionando con una búsqueda simple del catálogo.
ANTHROPIC_API_KEY=

# Opcional: modelo del asistente (por defecto claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# URL pública del sitio (metadatos, datos estructurados).
NEXT_PUBLIC_SITE_URL=https://tienda.sarumadi.com
